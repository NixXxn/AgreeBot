# ------------------------------------------------------------------------------
# YOUR WALLET CONFIGURATION (live trading)
# ------------------------------------------------------------------------------
# Legacy names (still supported):
PROXY_WALLET=
PRIVATE_KEY=

# Preferred Polymarket deposit-wallet aliases (signature type 3 / POLY_1271):
# POLY_FUNDER = deposit / trading wallet from Polymarket settings
# POLY_PRIVATE_KEY = EOA private key that owns that deposit wallet
POLY_SIGNATURE_TYPE=3
POLY_FUNDER=
POLY_PRIVATE_KEY=

# Optional — Relayer API key (gasless wallet ops from Polymarket → Settings → API Keys)
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# ------------------------------------------------------------------------------
# DASHBOARD LOGIN (optional — when both set, /login is required)
# ------------------------------------------------------------------------------
DASHBOARD_USER=
DASHBOARD_TOKEN=

# ------------------------------------------------------------------------------
# POLYMARKET API ENDPOINTS
# ------------------------------------------------------------------------------
CLOB_HTTP_URL = 'https://clob.polymarket.com/'
CLOB_WS_URL = 'wss://ws-subscriptions-clob.polymarket.com/ws'

# ------------------------------------------------------------------------------
# BOT SETTINGS
# ------------------------------------------------------------------------------
# How often to check for new trades (in seconds)
# With many wallets (20–50), use 5–15 to avoid Polymarket rate limits
FETCH_INTERVAL = 5

# Ignore trades older than X hours
TOO_OLD_TIMESTAMP = 1

# Maximum retry attempts for failed orders
RETRY_LIMIT = 3

# Network request timeout in milliseconds (default: 10000 = 10 seconds)
# Increase if you experience frequent timeout errors
REQUEST_TIMEOUT_MS = 10000

# Maximum retry attempts for network errors (default: 3)
# Helps handle temporary connection issues to Polymarket API
NETWORK_RETRY_LIMIT = 3

# ==============================================================================
# COPY STRATEGY CONFIGURATION (NEW SYSTEM!)
# ==============================================================================
# Choose your copy strategy: PERCENTAGE, FIXED, ADAPTIVE, or KELLY
# - PERCENTAGE: Copy a fixed % of trader's order
# - FIXED: Copy a fixed dollar amount per trade
# - ADAPTIVE: Dynamically adjust % based on trade size
# - KELLY: Size from YOUR bankroll (half-Kelly by default) — ignores trader bet size
#          Recommended for multi-trader / consensus mode
COPY_STRATEGY = 'KELLY'

# Main parameter - meaning depends on strategy:
# - PERCENTAGE: Percentage of trader's order (e.g., 10.0 = 10%)
# - FIXED: Fixed dollar amount per trade (e.g., 50.0 = $50)
# - ADAPTIVE: Base percentage for adaptive scaling (e.g., 10.0 = 10%)
# - KELLY: unused for sizing (kept for compatibility)
COPY_SIZE = 10.0

# ------------------------------------------------------------------------------
# KELLY / HALF-KELLY (only when COPY_STRATEGY = KELLY)
# ------------------------------------------------------------------------------
# Stake = bankroll × min(KELLY_FRACTION × f*, KELLY_MAX_FRACTION)
# where f* = (p − price) / (1 − price) and p = price + KELLY_EDGE
#
# KELLY_FRACTION=0.5 → classic half Kelly (recommended)
# KELLY_EDGE=0.05 → assume +5 percentage points edge vs market (copy/consensus edge)
# KELLY_MAX_FRACTION=0.25 → never risk more than 25% of bankroll on one bet
KELLY_FRACTION = 0.5
KELLY_EDGE = 0.05
KELLY_MAX_FRACTION = 0.25

# ------------------------------------------------------------------------------
# SAFETY LIMITS (Protect your account!)
# ------------------------------------------------------------------------------
# Maximum size for a single order in USD
# With KELLY, raise this or Kelly stakes get capped here (e.g. 500–2000)
MAX_ORDER_SIZE_USD = 500.0

# Minimum size for a single order in USD (default: 1.0)
# Orders below this will be skipped (Polymarket requirement)
MIN_ORDER_SIZE_USD = 1.0

# Optional: Maximum total position size in USD (per market)
# Prevents accumulating too large position in one market
# MAX_POSITION_SIZE_USD = 500.0

# Optional: Maximum total trading volume per day in USD
# Prevents overtrading in a single day
# MAX_DAILY_VOLUME_USD = 1000.0

# ------------------------------------------------------------------------------
# ADAPTIVE STRATEGY PARAMETERS (Only used if COPY_STRATEGY = 'ADAPTIVE')
# ------------------------------------------------------------------------------
# Minimum percentage for large orders (default: 5.0)
ADAPTIVE_MIN_PERCENT = 5.0

# Maximum percentage for small orders (default: 20.0)
ADAPTIVE_MAX_PERCENT = 20.0

# Threshold in USD to trigger adaptation (default: 500.0)
# Orders above this use lower %, orders below use higher %
ADAPTIVE_THRESHOLD_USD = 500.0

# ==============================================================================
# TIERED MULTIPLIERS (NEW FEATURE!)
# ==============================================================================
# Apply different multipliers based on trader's position size
# Solves the problem of copying traders with varying position sizes:
# - Small trades get higher multipliers (don't miss opportunities)
# - Large trades get lower multipliers (prevent over-allocation)
#
# Format: "min-max:multiplier,min-max:multiplier,min+:multiplier"
# - Use "min-max" for bounded ranges
# - Use "min+" for infinite upper bound (must be last)
# - Ranges are in USD based on trader's order size
#
# Example for $2k account copying a $500k-$1M trader:
# TIERED_MULTIPLIERS = 1-10:2.0,10-100:1.0,100-500:0.2,500-1000:0.1,1000-5000:0.02,5000-10000:0.01,10000-50000:0.002,50000-100000:0.001,100000-500000:0.0005,500000+:0.0002
#
# What this does:
# - $5 trader order × 2.0x = $10 copy (capture small trades)
# - $50 trader order × 1.0x = $50 copy
# - $500 trader order × 0.1x = $50 copy
# - $10,000 trader order × 0.002x = $20 copy
# - $250,000 trader order × 0.0002x = $50 copy (manage large trades)
#
# Simpler example for $1k account:
# TIERED_MULTIPLIERS = 1-100:2.0,100-1000:0.5,1000-10000:0.1,10000+:0.01
#
# Leave unset to use single TRADE_MULTIPLIER or no multiplier (1.0x)

# ==============================================================================
# LEGACY CONFIGURATION (For backward compatibility)
# ==============================================================================
# These are kept for compatibility with old .env files
# If you don't set COPY_STRATEGY, the bot will use these:
# - COPY_PERCENTAGE: Percentage of trader's order size (default: 10.0)
# - TRADE_MULTIPLIER: Single multiplier applied to copy percentage (default: 1.0)
# ⚠️  DEPRECATED: Please migrate to new COPY_STRATEGY system above!
# ⚠️  NOTE: If TIERED_MULTIPLIERS is set, it overrides TRADE_MULTIPLIER
# COPY_PERCENTAGE = 10.0
# TRADE_MULTIPLIER = 1.0

# ------------------------------------------------------------------------------
# TRADE AGGREGATION SETTINGS (NEW!)
# ------------------------------------------------------------------------------
# Enable trade aggregation for small trades (default: false)
# - true = Combine multiple small trades from the same trader into one larger trade
# - false = Execute each trade individually (original behavior)
# 💡 Useful when traders make many small trades that individually fall below
#    Polymarket's $1 minimum but together would be worth copying!
TRADE_AGGREGATION_ENABLED = false

# Time window to wait for more trades before executing (in seconds)
# Default: 300 (5 minutes)
# - 60 = 1 minute
# - 300 = 5 minutes (recommended)
# - 600 = 10 minutes
# ⏱️  Longer windows allow more trades to combine but delay execution
TRADE_AGGREGATION_WINDOW_SECONDS = 300

# ------------------------------------------------------------------------------
# PAPER / PREVIEW MODE (no wallet required)
# ------------------------------------------------------------------------------
# When true, the bot only monitors traders and logs what it WOULD trade.
# PROXY_WALLET and PRIVATE_KEY are optional — you only need:
#   USER_ADDRESSES + MONGO_URI (+ PAPER_MODE=true)
#
# Coolify paper deploy minimum:
#   PAPER_MODE=true
#   USER_ADDRESSES=<your trader list>
#   MONGO_URI=mongodb+srv://...
#   CONSENSUS_ENABLED=true   (optional)
#
# Set false for live trading (requires POLY_FUNDER + POLY_PRIVATE_KEY or PROXY_WALLET + PRIVATE_KEY)
PAPER_MODE=false
# Virtual USDC bankroll used only for sizing logs in paper mode (default 10000)
PAPER_BALANCE_USD=10000
# PREVIEW_MODE is an alias of PAPER_MODE (either works)
# PREVIEW_MODE=false

# ------------------------------------------------------------------------------
# CONSENSUS / MULTI-TRADER AGREEMENT (AgreeBot)
# ------------------------------------------------------------------------------
# Only enter a trade when enough tracked traders agree on the same outcome.
# "Agree" = same market (conditionId) + same outcome token (asset) + same side.
#
# Example: 3 traders in USER_ADDRESSES, CONSENSUS_MIN_AGREEMENT=2
# → Bot waits until at least 2 of them BUY the same Yes/No within the window,
#   then places a single copy order. If the window expires first, the signal is skipped.
#
# Requires 2+ addresses in USER_ADDRESSES to be useful.
CONSENSUS_ENABLED = false

# Minimum unique traders that must take the same side on the same outcome
CONSENSUS_MIN_AGREEMENT = 2

# How long to wait for more traders to agree (seconds)
# - 60  = 1 minute (fast markets)
# - 300 = 5 minutes (recommended)
# - 900 = 15 minutes (slower confirmation)
CONSENSUS_WINDOW_SECONDS = 300

# Which sides require consensus: BUY | SELL | BOTH
# BUY = only gate entries; sells from any trader still copy immediately
CONSENSUS_APPLY_TO = BUY

# How to size the single order once consensus is reached:
# AVERAGE | LARGEST | MEDIAN | FIRST
CONSENSUS_SIZE_MODE = AVERAGE

# Max book slippage vs last agreeing trader's fill price (± percent).
# BUY asks outside [ref*(1-x%), ref*(1+x%)] are skipped. Default 15.
MAX_SLIPPAGE_PERCENT = 15

# Health HTTP port (Coolify / Docker healthchecks hit GET /health)
HEALTH_PORT = 3000
# PORT = 3000

# Host port for bundled MongoDB in docker-compose (container stays on 27017)
MONGO_PORT = 27017

# ------------------------------------------------------------------------------
# AUTO-RESOLVE SETTINGS (NEW!)
# ------------------------------------------------------------------------------
# Automatically sell positions that have resolved (price at 100% or 0%)
# - true = Auto-sell winning positions (price >= 99%) and losing positions (price <= 1%)
# - false = Manual resolution only (use npm run close-resolved)
# 💡 Saves gas vs on-chain redemption, but may not get exact $1.00 for winners
AUTO_RESOLVE_ENABLED = false

# How often to check for resolved positions (in seconds)
# Default: 60 (1 minute)
# - 30 = Check every 30 seconds (more responsive)
# - 60 = Check every 1 minute (recommended)
# - 300 = Check every 5 minutes (less frequent)
AUTO_RESOLVE_INTERVAL = 60

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# MongoDB connection string
# ⚠️  Keep this private! Never share or commit to git!
MONGO_URI = 'mongodb+srv://username:password@cluster.mongodb.net/database'

# ------------------------------------------------------------------------------
# BLOCKCHAIN CONFIGURATION (Polygon Mainnet)
# ------------------------------------------------------------------------------
# Polygon RPC endpoint (you can use Infura, Alchemy, or QuickNode)
# Free public default (polygon-rpc.com is dead / 401). Prefer Alchemy/Infura for production.
RPC_URL = 'https://polygon-bor-rpc.publicnode.com'
# RPC_URL = 'https://polygon-mainnet.infura.io/v3/YOUR_INFURA_KEY'

# USDC Contract Address on Polygon (DO NOT CHANGE)
USDC_CONTRACT_ADDRESS = '0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174'

# ==============================================================================
# SECURITY NOTES:
# - Never commit .env file to git (it's in .gitignore)
# - Use a dedicated wallet with limited funds for the bot
# - Regularly monitor bot activity
# - Change MongoDB password if exposed
# ==============================================================================
