{
    "name": "agreebot",
    "version": "1.1.0",
    "main": "index.js",
    "description": "Polymarket multi-trader copy bot with consensus agreement and Coolify deploy",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "ts-node src/index.ts",
        "check-allowance": "ts-node src/scripts/checkAllowance.ts",
        "verify-allowance": "ts-node src/scripts/verifyAllowance.ts",
        "set-token-allowance": "ts-node src/scripts/setTokenAllowance.ts",
        "manual-sell": "node dist/scripts/manualSell.js",
        "sell-large": "node dist/scripts/sellLargePositions.js",
        "transfer-to-gnosis": "node dist/scripts/transferPositionsToGnosisSafe.js",
        "fetch-history": "node dist/scripts/fetchHistoricalTrades.js",
        "simulate": "node dist/scripts/simulateProfitability.js",
        "simulate-old": "node dist/scripts/simulateProfitabilityOldLogic.js",
        "sim": "node dist/scripts/runSimulations.js",
        "compare": "node dist/scripts/compareResults.js",
        "check-stats": "node dist/scripts/checkMyStats.js",
        "check-pnl": "node dist/scripts/checkPnLDiscrepancy.js",
        "check-proxy": "node dist/scripts/checkProxyWallet.js",
        "check-both": "node dist/scripts/checkBothWallets.js",
        "close-stale": "node dist/scripts/closeStalePositions.js",
        "close-resolved": "node dist/scripts/closeResolvedPositions.js",
        "redeem-resolved": "node dist/scripts/redeemResolvedPositions.js",
        "check-activity": "node dist/scripts/checkRecentActivity.js",
        "find-traders": "node dist/scripts/findBestTraders.js",
        "find-low-risk": "node dist/scripts/findLowRiskTraders.js",
        "scan-traders": "node dist/scripts/scanBestTraders.js",
        "scan-markets": "node dist/scripts/scanTradersFromMarkets.js",
        "aggregate": "node dist/scripts/aggregateResults.js",
        "audit": "node dist/scripts/auditCopyTradingAlgorithm.js",
        "audit-fixed": "node dist/scripts/auditCopyTradingAlgorithmFixed.js",
        "health-check": "node dist/scripts/healthCheck.js",
        "analyze": "ts-node src/scripts/analyzeAllTraders.ts",
        "analyze:my-trades": "ts-node src/scripts/analyzeMyTrades.ts",
        "analyze:all": "ts-node src/scripts/analyzeAllTraders.ts && ts-node src/scripts/analyzeMyTrades.ts",
        "web": "cd web && npm run dev",
        "web:build": "cd web && npm run build",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --write .",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "keywords": [
        "polymarket",
        "copy-trading",
        "consensus",
        "coolify"
    ],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.10",
        "@typescript-eslint/eslint-plugin": "^8.22.0",
        "@typescript-eslint/parser": "^8.22.0",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.3",
        "globals": "^15.14.0",
        "jest": "^29.7.0",
        "prettier": "^3.4.2",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.23.0"
    },
    "dependencies": {
        "@polymarket/clob-client-v2": "^1.2.1",
        "axios": "^1.7.9",
        "chalk": "^5.4.1",
        "dotenv": "^16.4.7",
        "ethers": "^5.8.0",
        "moment": "^2.30.1",
        "mongoose": "^8.9.5",
        "ora": "^8.2.0",
        "tslib": "^2.9.1"
    },
    "packageManager": "yarn@4.10.3+sha512.c38cafb5c7bb273f3926d04e55e1d8c9dfa7d9c3ea1f36a4868fa028b9e5f72298f0b7f401ad5eb921749eb012eb1c3bb74bf7503df3ee43fd600d14a018266f"
}
